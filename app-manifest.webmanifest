{
  "id": "./app/",
  "name": "HIROFJET ADMIN",
  "short_name": "HJ ADMIN",
  "description": "Hirofjet 管理后台：审核、举报、成员与内容管理。仅管理员可登录。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./app/",
  "scope": "./app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#05070b",
  "theme_color": "#05070b",
  "categories": ["productivity", "business"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
