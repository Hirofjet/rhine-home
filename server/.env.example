# ============================================================
# 后端环境变量（复制为 server/.env 后修改；必须配置 MySQL）
# ============================================================
PORT=3001
NODE_ENV=production

# ---------- MySQL（必填） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rhine
DB_PASSWORD=change-me
DB_NAME=rhine_home

# ---------- 初始超级管理员（仅在用户表为空时创建） ----------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# ---------- 会话 ----------
SESSION_HOURS=12

# ---------- 上传目录（默认 server/uploads） ----------
# UPLOAD_DIR=./uploads

# ---------- SMTP（注册 / 重置密码验证码；不配置则验证码打印到日志） ----------
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=your@qq.com
# SMTP_PASS=授权码
# SMTP_FROM=RHINE//HOME <your@qq.com>

# 本地调试时允许接口返回验证码（生产必须为 0）
ALLOW_DEV_CODES=0

# 前后端分域部署时填写允许的来源，逗号分隔；同域部署留空
# CORS_ORIGIN=https://example.com
