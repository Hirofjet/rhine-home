# 后端服务配置（复制为 server/.env 后按需修改；也可直接用环境变量）
PORT=3001

# 首次启动、库里没有用户时自动创建的管理员账号
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# 跨域白名单（前后端不同域时填，逗号分隔；同域部署可留空）
# CORS_ORIGIN=http://localhost:5173

# MySQL（不配置则使用 server/data/*.json 文件存储）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=rhine_home

# 可选：自定义上传与数据目录（默认 server/uploads、server/data）
# UPLOAD_DIR=./uploads
# DATA_DIR=./data
