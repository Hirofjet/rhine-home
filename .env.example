# 前端环境变量（复制为 .env 后按需修改）
# 后端地址：本地开发走 Vite 代理，无需配置；前后端分离部署时填写，如 https://api.example.com
# VITE_API_BASE=http://localhost:3001

# 管理后台入口路径（不写入前台导航，构建时生效）
# VITE_ADMIN_PATH=/admin

# 公开合规信息
# VITE_COMPLAINT_EMAIL=security@example.com
# VITE_SECURITY_OFFICER=安全负责人
# VITE_COMPLAINT_PHONE=
# VITE_ICP_NUMBER=
# VITE_PSB_NUMBER=
# VITE_ACCESS_PROVIDER=
# VITE_APPROVAL_DATE=
